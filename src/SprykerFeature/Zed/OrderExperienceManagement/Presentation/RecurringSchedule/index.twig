{% extends '@Gui/Layout/layout.twig' %}

{% block section_title %}
    {{ 'Recurring Order Schedules' | trans }}
{% endblock %}

{% block content %}
    {% include '@OrderExperienceManagement/Partials/forecast-summary.twig' with {
        forecasts: forecastCollection.forecasts,
        monthLabel: forecastMonthLabel,
    } %}

    {% embed '@Gui/Partials/widget.twig' with { widget_title: 'List of Recurring Order Schedules' | trans } %}
        {% block widget_content %}
            {% include '@OrderExperienceManagement/Partials/table-filter-form.twig' with { form: recurringScheduleTableFilterForm } %}

            {{ recurringScheduleTable | raw }}
        {% endblock %}
    {% endembed %}
{% endblock %}
