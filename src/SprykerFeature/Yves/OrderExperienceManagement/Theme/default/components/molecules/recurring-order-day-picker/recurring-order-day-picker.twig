{% extends model('component') %}

{% define config = {
    name: 'recurring-order-day-picker',
} %}

{% define data = {
    field: required,
} %}

{% block body %}
    {% block title %}
        {{ form_label(data.field) }}
    {% endblock %}

    {% block errors %}
        {{ form_errors(data.field) }}
    {% endblock %}

    {% block days %}
        <div>
            {{ form_widget(data.field, {
                label_attr: {
                    class: "list--inline",
                }}) }}
            }}
        </div>
    {% endblock %}
{% endblock %}
