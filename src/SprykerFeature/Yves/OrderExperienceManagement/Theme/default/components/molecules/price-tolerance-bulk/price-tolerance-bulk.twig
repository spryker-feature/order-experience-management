{% extends model('component') %}

{% define config = {
    name: 'price-tolerance-bulk',
    tag: 'price-tolerance-bulk',
} %}

{% define data = {
    form: required,
    productRows: [],
    currencyIsoCode: required,
    isLocked: false,
} %}

{% define attributes = {
    'currency-iso-code': data.currencyIsoCode,
    'any-increase-label': 'recurring_orders.price_tolerance.products.any_increase' | trans,
    'summary-label': 'recurring_orders.price_tolerance.products.summary' | trans,
} %}

{% block body %}
    {% block title %}
        <h3 class="title--h6">{{ 'recurring_orders.price_tolerance.products.title' | trans }}</h3>
    {% endblock %}

    {% block ignoredNotice %}
        <p class="{{ config.name }}__ignored-notice" {{ qa('recurring-order-product-tolerances-ignored') }}>
            {{ 'recurring_orders.price_tolerance.products.ignored_notice' | trans }}
        </p>
    {% endblock %}

    <div class="{{ config.name }}__content">
        {% block heading %}
            {% set withToleranceCount = data.productRows | filter(row => row.hasTolerance) | length %}
            {% set reviewsAnyIncreaseCount = data.productRows | filter(row => row.isReviewingAnyIncrease) | length %}

            <div class="grid grid--justify grid--middle">
                <div class="col col--sm-8">
                    {% block intro %}
                        <p>{{ 'recurring_orders.price_tolerance.products.intro' | trans }}</p>
                    {% endblock %}
                </div>

                <div class="col col--sm-4 text-right">
                    {% block summary %}
                        {% include molecule('status') with {
                            class: config.jsName ~ "__summary",
                            attributes: {
                                'data-qa': 'recurring-order-product-tolerances-summary'
                            },
                            data: {
                                status: 'info',
                                label: 'recurring_orders.price_tolerance.products.summary' | trans({
                                '%with%': withToleranceCount,
                                '%any%': reviewsAnyIncreaseCount,
                            }),
                            },
                        } only %}
                    {% endblock %}
                </div>
            </div>
        {% endblock %}

        {% set firstItemForm = data.form.items | first %}
        {% if not data.isLocked and firstItemForm %}
            {% block bar %}
                {% set toleranceFieldAttributes = firstItemForm.tolerance.vars.attr %}
                {% include molecule('price-tolerance-bulk-bar', 'OrderExperienceManagement') with {
                    class: config.jsName ~ '__bar',
                    data: {
                        valueAttributes: {
                            min: toleranceFieldAttributes.min,
                            max: toleranceFieldAttributes.max,
                            step: toleranceFieldAttributes.step,
                        },
                    },
                } only %}
            {% endblock %}
        {% endif %}

        {% block table %}
            {% set toleranceColumns = [] %}
            {% if not data.isLocked %}
                {% set toleranceColumns = toleranceColumns | merge([{
                    id: 'select',
                    title: 'recurring_orders.price_tolerance.bulk.select_all',
                    type: 'checkbox',
                    head: {
                        type: 'checkbox',
                    },
                    options: {
                        selectable: true,
                    },
                }]) %}
            {% endif %}
            {% set toleranceColumns = toleranceColumns | merge([
                { id: 'product', title: 'recurring_orders.detail.order_items.column.product' },
                { id: 'unitPrice', title: 'recurring_orders.price_tolerance.products.column.unit_price' },
                { id: 'quantity', title: 'recurring_orders.detail.order_items.column.quantity' },
                { id: 'tolerance', title: 'recurring_orders.price_tolerance.products.column.tolerance', type: 'input' },
                { id: 'reviewAbove', title: 'recurring_orders.price_tolerance.products.column.review_above' },
            ]) %}

            {% set toleranceRows = [] %}
            {% for itemForm in data.form.items %}
                {% set row = data.productRows[loop.index0] %}
                {% set productName = row.item.productName ?: row.item.sku %}

                {% set productCell %}
                    <div class="{{ config.name }}__product-name">
                        {{- productName -}}
                    </div>
                    <span class="{{ config.name }}__product-sku">{{ row.item.sku }}</span>
                    {% widget 'SoldByMerchantWidget' args [row.item] only %}{% endwidget %}
                {% endset %}

                {% set reviewAboveCell %}
                    <span class="{{ config.jsName }}__trigger">
                        {%- if row.triggerPrice is not null -%}
                            <strong>{{ row.triggerPrice | money(true, data.currencyIsoCode) }}</strong>
                        {%- else -%}
                            {{ 'recurring_orders.price_tolerance.products.any_increase' | trans }}
                        {%- endif -%}
                    </span>
                {% endset %}

                {% set toleranceRows = toleranceRows | merge([{
                    _row: {
                        class: "#{config.jsName}__row",
                        attributes: {
                            'data-unit-price': row.unitPrice,
                            'data-qa': 'recurring-order-product-tolerance-row',
                        },
                    },
                    select: { label: 'recurring_orders.price_tolerance.bulk.select_row' | trans({'%product%': productName}) },
                    product: productCell,
                    unitPrice: row.unitPrice | money(true, data.currencyIsoCode),
                    quantity: row.quantity,
                    tolerance: {
                        field: itemForm.tolerance,
                        fieldAttributes: { class: "#{config.jsName}__tolerance" },
                        cellText: '%',
                    },
                    reviewAbove: reviewAboveCell,
                }]) %}
            {% endfor %}

            {% include molecule('advanced-table') with {
                data: {
                    columns: toleranceColumns,
                    rows: toleranceRows,
                },
            } only %}
        {% endblock %}

        {% block note %}
            <p>{{ 'recurring_orders.price_tolerance.products.note' | trans }}</p>
        {% endblock %}
    </div>

    {% block priseLimitHolder %}
        <template data-id="{{ config.jsName }}__price-limit-holder">
            <strong class="{{ config.name }}__price-limit-holder"></strong>
        </template>
    {% endblock %}
{% endblock %}
