{% extends model('component') %}

{% define config = {
    name: 'recurring-order-confirmed',
} %}

{% define data = {
    recurringOrderSettings: required,
    cadenceTypeEveryNWeeks: required,
    cadenceTypeByDays: '',
    weekDayGlossaryKeys: {},
} %}

{% block body %}
    {% set selectedWeekDays = data.recurringOrderSettings.cadenceOptions | default([]) %}
    {% set selectedDayLabels = [] %}
    {% for weekDay, glossaryKey in data.weekDayGlossaryKeys %}
        {% if (weekDay ~ '') in selectedWeekDays %}
            {% set selectedDayLabels = selectedDayLabels | merge([glossaryKey | trans]) %}
        {% endif %}
    {% endfor %}

    {% set items = [
        {
            label: 'recurring_orders.checkout.cadence_label' | trans,
            value: ('recurring_orders.cadence.' ~ data.recurringOrderSettings.cadenceType) | trans,
            enabled: true,
        },
        {
            label: 'recurring_orders.checkout.cadence_value_label' | trans,
            value: data.recurringOrderSettings.cadenceValue,
            enabled: data.recurringOrderSettings.cadenceType == data.cadenceTypeEveryNWeeks and data.recurringOrderSettings.cadenceValue,
        },
        {
            label: 'recurring_orders.checkout.days_label' | trans,
            value: selectedDayLabels | join(', '),
            enabled: data.recurringOrderSettings.cadenceType == data.cadenceTypeByDays and selectedDayLabels is not empty,
        },
        {
            label: 'recurring_orders.checkout.schedule_name_label' | trans,
            value: data.recurringOrderSettings.scheduleName,
            enabled: data.recurringOrderSettings.scheduleName is not empty,
        },
    ] %}
    {% set listClassName = 'list' %}
    {% set listItemClassName = 'list__item' %}

    {% block firstOrderNotice %}
        {% if data.recurringOrderSettings.firstOrderDate is not empty %}
            <p class="{{ config.name }}__first-order-notice">
                {{ 'recurring_orders.checkout.first_order_notice' | trans({ '%date%': data.recurringOrderSettings.firstOrderDate | formatDate }) }}
            </p>
        {% endif %}
    {% endblock %}

    {% block list %}
        <ul class="{{ listClassName }}">
            {% for item in items | filter(item => item.enabled) %}
                <li class="{{ listItemClassName }}">
                    <strong>{{ item.label }}:</strong>
                    <span>{{ item.value }}</span>
                </li>
            {% endfor %}
        </ul>
    {% endblock %}
{% endblock %}
