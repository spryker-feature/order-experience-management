{% extends model('component') %}

{% define config = {
    name: 'review-summary-banner',
} %}

{% define data = {
    review: required,
    currencyIsoCode: required,
    isProductCheckIgnored: false,
} %}

{% block component %}
    {% if data.review.orderReview or
          data.review.removedItemCount or
          data.review.priceChangeCount or
          data.review.substitutedCount or
          data.review.unavailableCount %}
        {{ parent() }}
    {% endif %}

    <div class="is-hidden">
        {{ block('newValue') }}
    </div>
{% endblock %}

{% block body %}
    {% set gridClassName = config.name ~ '__alert alert alert--warning grid grid--gap grid--justify' %}
    {% block grid %}
        <div class="{{ gridClassName }}" data-qa="recurring-order-review-summary-banner">
            <div class="col col--expand">
                {% block items %}
                    {% set summaryItems = [
                        { count: data.review.priceChangeCount, key: 'recurring_orders.review.banner.price_change' },
                        { count: data.review.substitutedCount, key: 'recurring_orders.review.banner.substituted' },
                        { count: data.review.unavailableCount, key: 'recurring_orders.review.banner.unavailable' },
                    ] %}

                    {% set summaryParts = [] %}
                    {% for item in summaryItems | filter(item => item.count > 0) %}
                        {% set summaryParts = summaryParts | merge([item.key | trans({'%count%': item.count})]) %}
                    {% endfor %}

                    {% if summaryParts %}
                        <p>{{ summaryParts | join(' | ') }}</p>
                    {% endif %}

                    {% block orderTotalDetails %}
                        {% set orderReview = data.review.orderReview %}

                        {% if orderReview %}
                            <p {{ qa('recurring-order-review-order-total') }}>
                                {{ 'recurring_orders.review.order_total.rose_beyond_tolerance' | trans({
                                    '%previous_total%': orderReview.previousTotal | money(true, data.currencyIsoCode),
                                    '%current_total%': orderReview.currentTotal | money(true, data.currencyIsoCode),
                                    '%increase%': orderReview.increasePercent ~ '%',
                                    '%tolerance%': orderReview.tolerancePercent.trim() ~ '%',
                                }) }}

                                {% if orderReview.isOrderTotalOnly %}
                                    <span {{ qa('recurring-order-review-order-total-only') }}></span>
                                {% endif %}
                            </p>
                        {% endif %}
                    {% endblock %}
                {% endblock %}
            </div>
            <div class="col">
                {% block dataChange %}
                    {% block oldValue %}
                        <s>{{ data.review.originalTotal | money(true, data.currencyIsoCode) }}</s>
                    {% endblock %}

                    {% block staticNewValue %}
                        <span data-qa="recurring-order-review-banner-total">
                            {{ data.review.updatedTotal | money(true, data.currencyIsoCode) }}
                            {% if data.review.totalChangePercent %}
                                <span class="{{ config.name }}__change" data-qa="recurring-order-review-banner-change">({{ data.review.totalChangePercent }}%)</span>
                            {% endif %}
                        </span>
                    {% endblock %}
                {% endblock %}
            </div>
        </div>
    {% endblock %}
{% endblock %}

{% block newValue %}
    <span>
        {% include molecule('review-summary-banner-price', 'OrderExperienceManagement') with {
            data: {
                total: data.review.updatedTotal | money(true, data.currencyIsoCode),
                currency: data.currencyIsoCode,
                originalTotal: data.review.originalTotal,
            },
        } only %}
    </span>
{% endblock %}
