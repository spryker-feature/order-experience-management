{% extends model('component') %}

{% define config = {
    name: 'schedule-detail-sidebar',
} %}

{% define data = {
    schedule: required,
    statusClassMap: required,
    quote: data.quote,
    editModalTriggerClassName: '',
    weekDayGlossaryKeys: {},
    withBudgetSummary: false,
    isPriceToleranceLocked: false,
} %}

{% block extraClass %} box {% endblock %}

{% block body %}
    {% set titleClassName = config.name ~ '__title'%}
    {% block title %}
        <div class="{{ config.name }}__heading">
            <h4 class="{{ titleClassName }} col col--expand">{{ 'recurring_orders.detail.sidebar.title' | trans }}</h4>
            {% set editButtonClassName = "button button--hollow" %}

            {% block editButton %}
                {% if data.editModalTriggerClassName %}
                    <button type="button" class="{{ data.editModalTriggerClassName }} {{ editButtonClassName}}"
                            aria-label="{{ 'recurring_orders.detail.edit.title' | trans }}"
                            {{ qa('recurring-order-edit-schedule-button') }}>
                        {% block editButtonIcon %}
                            {% include atom('icon') with {
                                data: {
                                    name: 'edit',
                                },
                            } only %}
                        {% endblock %}
                    </button>
                {% endif %}
            {% endblock %}
        </div>
    {% endblock %}

    {% set definitionListClassName = config.name ~ '__fields' %}
    {% set definitionListKeyClassName = config.name ~ '__label' %}
    {% set definitionListValueClassName = config.name ~ '__value spacing-bottom' %}
    {% set definitionListLinkClassName = 'link' %}

    {% block definitionList %}
        <dl class="{{ definitionListClassName }}">
            {% block originalOrder %}
                {% if data.schedule.idSourceSalesOrder %}
                    <dt class="{{ definitionListKeyClassName }}">{{ 'recurring_orders.detail.source_order' | trans }}</dt>
                    <dd class="{{ definitionListValueClassName }}">
                        <a href="{{ path('customer/order/details', {id: data.schedule.idSourceSalesOrder}) }}"
                            class="{{ definitionListLinkClassName }}"
                            target="_blank">
                            {{ 'recurring_orders.detail.history.view_order' | trans }}
                        </a>
                    </dd>
                {% endif %}
            {% endblock %}

            {% block cadence %}
                {% set selectedDayLabels = [] %}
                {% for weekDay, glossaryKey in data.weekDayGlossaryKeys %}
                    {% if (weekDay ~ '') in data.schedule.cadenceOptions %}
                        {% set selectedDayLabels = selectedDayLabels | merge([glossaryKey | trans]) %}
                    {% endif %}
                {% endfor %}

                <dt class="{{ definitionListKeyClassName }}">{{ 'recurring_orders.detail.sidebar.cadence' | trans }}</dt>
                <dd class="{{ definitionListValueClassName }}" data-qa="recurring-order-cadence">
                    {{ ('recurring_orders.cadence.' ~ data.schedule.cadenceType) | trans }}
                    {% if data.schedule.cadenceValue %}
                        ({{ data.schedule.cadenceValue }})
                    {% endif %}
                    {% if selectedDayLabels is not empty %}
                        ({{ selectedDayLabels | join(', ') }})
                    {% endif %}
                </dd>
            {% endblock %}

            {% block status %}
                <dt class="{{ definitionListKeyClassName }}">{{ 'recurring_orders.detail.sidebar.status' | trans }}</dt>
                <dd class="{{ definitionListValueClassName }}" data-qa="recurring-order-status-badge">
                    {% include molecule('status') with {
                        data: {
                            label: ('recurring_orders.status.' ~ data.schedule.status) | trans,
                            status: data.statusClassMap[data.schedule.status],
                        }
                    } only %}
                </dd>
            {% endblock %}

            {% block createdAt %}
                {% if data.schedule.createdAt %}
                    <dt class="{{ definitionListKeyClassName }}">{{ 'recurring_orders.detail.sidebar.created' | trans }}</dt>
                    <dd class="{{ definitionListValueClassName }}">{{ data.schedule.createdAt | formatDate }}</dd>
                {% endif %}
            {% endblock %}

            {% block createdBy %}
                {% if data.schedule.createdByName %}
                    <dt class="{{ definitionListKeyClassName }}">{{ 'recurring_orders.detail.sidebar.created_by' | trans }}</dt>
                    <dd class="{{ definitionListValueClassName }}">{{ data.schedule.createdByName }}</dd>
                {% endif %}
            {% endblock %}

            {% block priceTolerance %}
                {% set orderTolerance = data.schedule.priceTolerancePercent %}
                {% set isOrderToleranceSet = orderTolerance and orderTolerance.isPositive() %}
                {% set isProductCheckIgnored = data.schedule.isProductPriceChangeIgnored and isOrderToleranceSet %}
                {% set productsSetCount = isProductCheckIgnored ? 0 : (data.schedule.items | filter(item => item.priceTolerancePercent is not null and item.priceTolerancePercent.isPositive()) | length) %}

                <dt class="{{ definitionListKeyClassName }}">{{ 'recurring_orders.detail.sidebar.price_tolerance' | trans }}</dt>
                <dd class="{{ definitionListValueClassName }}" data-qa="recurring-order-price-tolerance">
                    <div class="grid grid--justify grid--middle">
                        <div class="col col--expand">
                            {% if isProductCheckIgnored %}
                                {{ 'recurring_orders.detail.sidebar.price_tolerance.order_total_ignored' | trans({'%tolerance%': orderTolerance.trim() ~ '%'}) }}
                            {% elseif isOrderToleranceSet and productsSetCount %}
                                {{ ((productsSetCount == 1 ? 'recurring_orders.detail.sidebar.price_tolerance.order_total_and_product' : 'recurring_orders.detail.sidebar.price_tolerance.order_total_and_products')) | trans({'%tolerance%': orderTolerance.trim() ~ '%', '%count%': productsSetCount}) }}
                            {% elseif isOrderToleranceSet %}
                                {{ 'recurring_orders.detail.sidebar.price_tolerance.order_total' | trans({'%tolerance%': orderTolerance.trim() ~ '%'}) }}
                            {% elseif productsSetCount %}
                                {{ (productsSetCount == 1 ? 'recurring_orders.detail.sidebar.price_tolerance.products_only_one' : 'recurring_orders.detail.sidebar.price_tolerance.products_only') | trans({'%count%': productsSetCount}) }}
                            {% else %}
                                <strong>{{ 'recurring_orders.detail.sidebar.price_tolerance.off' | trans }}</strong>
                                <small class="text-muted">{{ 'recurring_orders.detail.sidebar.price_tolerance.off_note' | trans }}</small>
                            {% endif %}
                        </div>

                        {% if not data.isPriceToleranceLocked %}
                            <div class="col">
                                <a href="{{ url('recurring-orders/price-tolerances', {uuid: data.schedule.uuid}) }}"
                                    class="link"
                                    {{ qa('recurring-order-edit-tolerances-button') }}>
                                    {% include atom('icon') with {
                                        data: {
                                            name: 'edit',
                                        },
                                    } only %}
                                    {{ 'general.edit.button' | trans }}
                                </a>
                            </div>
                        {% else %}
                            {% set lockedHintTooltipId = "#{config.name}__price-tolerance-locked-tooltip" %}
                            <div class="col">
                                {% include molecule('tooltip-message') with {
                                    attributes: {
                                        id: lockedHintTooltipId,
                                    },
                                    data: {
                                        text: 'recurring_orders.price_tolerance.locked_notice' | trans,
                                        hasTrigger: true,
                                        triggerLabel: 'recurring_orders.detail.sidebar.price_tolerance.locked_label' | trans,
                                        triggerAttributes: {
                                            'data-qa': 'recurring-order-price-tolerance-locked',
                                        },
                                    },
                                } only %}
                            </div>
                        {% endif %}
                    </div>
                </dd>
            {% endblock %}

            {% block additionalInfo %}
                {% widget 'CostCenterDetailWidget' args [data.quote, data.withBudgetSummary] with {
                    data: {
                        definitionListKeyClassName: definitionListKeyClassName,
                        definitionListValueClassName: definitionListValueClassName,
                    },
                    embed: {
                        configName: config.name
                    },
                } only %}
                    {% block body %}
                        {% embed molecule('cost-center-detail', 'PurchasingControl') with {
                            data: {
                                costCenterName: data.costCenterName,
                                budgetName: data.budgetName,
                                budgetSummary: data.budgetSummary,
                            },
                            embed: {
                                configName: embed.configName,
                            },
                        } only %}
                            {% block component %}
                                {% block listItems %}
                                    {% set listKeyClassName = embed.configName ~ '__label' %}
                                    {% set listValueClassName = embed.configName ~ '__value spacing-bottom' %}

                                    {{ parent() }}
                                {% endblock %}

                                {{ block('budgetSummary') }}
                            {% endblock %}
                        {% endembed %}
                    {% endblock %}
                {% endwidget %}
            {% endblock %}
        </dl>
    {% endblock %}
{% endblock %}
