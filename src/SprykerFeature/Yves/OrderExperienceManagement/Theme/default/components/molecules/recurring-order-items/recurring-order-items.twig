{% extends model('component') %}

{% define config = {
    name: 'recurring-order-items',
}%}

{% define data = {
    schedule: [],
    itemFlagLabelMap: [],
    itemFlagBadgeMap: [],
    orderReviewThreshold: null,
}%}

{% block component %}
    {% if data.schedule.items | length %}
        {{ parent() }}
    {% endif %}
{% endblock %}

{% block body %}
    <div data-qa="recurring-order-detail-items">
    {% set titleClassName = '' %}
    {% block title %}
        <h5 class="{{ titleClassName }}">{{ 'recurring_orders.detail.order_items.label' | trans }}</h5>
    {% endblock %}

    {% block table %}
        {% set itemColumns = [
            { id: 'product', title: 'recurring_orders.detail.order_items.column.product' },
            {
                id: 'priceTolerance',
                title: 'recurring_orders.detail.sidebar.price_tolerance',
                hint: {
                    text: 'recurring_orders.detail.order_items.price_tolerance.hint',
                    label: 'recurring_orders.detail.order_items.price_tolerance.hint_label',
                    attributes: {
                        'data-qa': 'recurring-order-price-tolerance-hint',
                    },
                },
            },
            { id: 'quantity', title: 'recurring_orders.detail.order_items.column.quantity' },
            { id: 'total', title: 'recurring_orders.detail.order_items.column.total' },
        ] %}

        {% set orderTolerance = data.schedule.priceTolerancePercent %}
        {% set isProductCheckIgnored = data.schedule.isProductPriceChangeIgnored and orderTolerance and orderTolerance.isPositive() %}

        {% set itemRows = [] %}
        {% for item in data.schedule.items %}
            {% set soldBy %}{% widget 'SoldByMerchantWidget' args [item] only %}{% endwidget %}{% endset %}
            {% set itemQuantity = item.nextDeliveryQuantity ?? item.quantity %}

            {% set productCell %}
                {{- item.productName ?: item.sku -}}
                {%- if item.productName %}<br><small class="text-muted">({{ item.sku }})</small>{% endif -%}
                {%- if item.configurableBundleName %}
                    <br><small class="text-muted">{{ 'recurring_orders.item.configurable_bundle_label' | trans({'%name%': item.configurableBundleName | trans | e}) }}</small>
                {%- endif -%}
                {%- for flag in item.flags %}
                    <br><span class="status status--{{ data.itemFlagBadgeMap[flag] ?? '' }}">{{ (data.itemFlagLabelMap[flag] ?? flag) | trans }}</span>
                {%- endfor -%}
                {{- soldBy -}}
            {% endset %}

            {% set quantityCell %}
                <span class="{{ config.jsName }}__qty-display" data-qa="recurring-order-detail-item-quantity">{{ itemQuantity }}</span>
                <input type="number" class="{{ config.jsName }}__qty-input is-hidden" data-item-id="{{ item.idRecurringScheduleItem }}" value="{{ itemQuantity }}" min="1">
            {% endset %}

            {% set priceTolerance = item.priceTolerancePercent %}

            {% if isProductCheckIgnored %}
                {% set priceToleranceLabel = 'recurring_orders.price_tolerance.order_total.title' | trans %}
            {% elseif priceTolerance is not null and priceTolerance.isPositive() %}
                {% set priceToleranceLabel = '+' ~ priceTolerance.trim() ~ '%' %}
            {% else %}
                {% set priceToleranceLabel = 'recurring_orders.price_tolerance.products.any_increase' | trans %}
            {% endif %}
            {% set priceToleranceCell %}
                <span class="status" data-qa="recurring-order-detail-item-price-tolerance">{{ priceToleranceLabel }}</span>
            {% endset %}

            {% set totalCell = item.itemTotal | money(true, data.schedule.currencyIsoCode) %}

            {% set itemRows = itemRows | merge([{
                product: productCell,
                priceTolerance: priceToleranceCell,
                quantity: quantityCell,
                total: totalCell,
            }]) %}
        {% endfor %}

        {% include molecule('advanced-table') with {
            data: {
                columns: itemColumns,
                rows: itemRows,
                emptyText: 'recurring_orders.detail.order_items.empty',
            },
        } only %}
    {% endblock %}

    {% block summary%}
        <div class="grid grid--justify spacing-top--small">
            <div class="col">
                <strong>{{ 'recurring_orders.detail.estimated_total.label' | trans }}</strong><br>
                <small class="text-muted">{{ 'recurring_orders.detail.estimated_total.info' | trans }}</small>
            </div>
            <div class="col col--right">
                <strong>{{ data.schedule.estimatedTotal | money(true, data.schedule.currencyIsoCode) }}</strong>
                {% block autoApprovedLimit %}
                    {% if data.orderReviewThreshold is not null %}
                        <br>
                        <small class="text-muted" {{ qa('recurring-order-detail-auto-approved-limit') }}>
                            {{ 'recurring_orders.detail.estimated_total.auto_approved' | trans({
                                '%threshold%': data.orderReviewThreshold | money(true, data.schedule.currencyIsoCode),
                                '%tolerance%': data.schedule.priceTolerancePercent.trim() ~ '%',
                            }) }}
                        </small>
                    {% endif %}
                {% endblock %}
            </div>
        </div>
    {% endblock %}
    </div>
{% endblock %}
