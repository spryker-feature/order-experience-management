{% extends model('component') %}

{% define config = {
    name: 'review-footer',
} %}

{% define data = {
    review: required,
    schedule: required,
    currencyIsoCode: required,
    confirmModalTriggerClassName: required,
} %}

{% block extraClass %} box {% endblock %}

{% set gridClassName = "grid grid--gap-smaller grid--justify grid--middle" %}
{% set dataColumnClassName = config.name ~ "__data-column col col--expand" %}
{% set actionsColumnClassName = config.name ~ "__actions-column col" %}

{% block body %}
    <div class="{{ gridClassName }}">
        {% block data %}
            <div class="{{ dataColumnClassName }}">
                {{ 'recurring_orders.review.footer.new_total' | trans }}:
                <span class="js-review-total-recalculator__total"
                    data-qa="recurring-order-review-footer-summary"></span>
            </div>
        {% endblock %}

        {% block actions %}
            <div class="{{ actionsColumnClassName }}">
                {% set backButtonClassName = 'button button--hollow' %}
                {% set acceptButtonClassName = 'button spacing-left' %}
                {% block backButton %}
                    <a href="{{ url('recurring-orders/detail', {uuid: data.schedule.uuid}) }}" class="{{ backButtonClassName }}" data-qa="recurring-order-review-back-link">
                        {{ 'recurring_orders.review.back_to_detail' | trans }}
                    </a>
                {% endblock %}

                {% block acceptButton %}
                    <button type="button" class="{{ acceptButtonClassName }} {{ data.confirmModalTriggerClassName }}" data-qa="recurring-order-review-accept-cta">
                        {{ 'recurring_orders.review.cta.accept_and_place' | trans }}
                    </button>
                {% endblock %}
            </div>
        {% endblock %}
    </div>
{% endblock %}
