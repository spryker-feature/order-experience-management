{% extends model('component') %}

{% define config = {
    name: 'review-blocking-errors',
} %}

{% define data = {
    blockingErrors: [],
} %}

{% block component %}
    {% if data.blockingErrors | length %}
        {{ parent()}}
    {% endif %}
{% endblock %}

{% set wrapperClassName = 'alert alert--danger' %}
{% set listClassName = 'list' %}
{% set listItemClassName = 'list__item' %}
{% block body %}
    <div class="{{ wrapperClassName }}">
        <ul class="{{ listClassName }}" qa('recurring-order-review-blocking-errors')>
            {% block blockingErrors %}
                {% for blockingError in data.blockingErrors %}
                    <li class="{{ listItemClassName }}">{{ blockingError.message | trans(blockingError.parameters ?? {}) }}</li>
                {% endfor %}
            {% endblock %}
        </ul>
    </div>
{% endblock %}
