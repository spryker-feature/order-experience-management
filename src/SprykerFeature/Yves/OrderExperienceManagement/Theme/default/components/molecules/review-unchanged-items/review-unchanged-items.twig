{% extends model('component') %}

{% define config = {
    name: 'review-unchanged-items',
} %}

{% define data = {
    unchangedItems: [],
    priceChanges: {},
    orderTolerance: null,
    isProductCheckIgnored: false,
    currencyIsoCode: required,
    priceMode: required,
    itemFlagLabelMap: {},
    itemFlagBadgeMap: {},
} %}

{% block component %}
    {% if data.unchangedItems | length %}
        {{ parent() }}
    {% endif %}
{% endblock %}

{% block body %}
    <details open>
        <summary>
            {{ (data.unchangedItems | length === 1 ? 'recurring_orders.review.unchanged.title' :'recurring_orders.review.unchanged.title.plural') | trans ({'%count%': data.unchangedItems | length}) }}
        </summary>

        {% set contentClassName = 'box' %}
        {% block content %}
            <div class="{{ contentClassName }}">
                {% set priceModeNet = 'NET_MODE' %}
                {% for item in data.unchangedItems %}
                    {% set referencePrice = data.priceMode == priceModeNet ? item.referenceNetPrice : item.referenceGrossPrice %}
                    {% set priceChange = data.priceChanges[item.groupKey] ?? null %}
                    {% set unitPrice = priceChange ? priceChange.current : referencePrice %}
                    {% set currentQuantity = item.nextDeliveryQuantity ?: item.quantity %}
                    {% set gridClassName = 'grid grid--gap grid--middle js-review-total-recalculator__line' %}
                    {% block grid %}
                        <div class="{{ gridClassName }}" data-unit-price="{{ unitPrice }}" data-quantity="{{ currentQuantity }}" data-line-total="{{ currentQuantity * unitPrice }}" data-unchanged-price-change="{{ priceChange ? 1 : '' }}">
                            {% block info %}
                                <div class="col col--expand">
                                    <div>
                                        {% block itemName %}
                                        <strong>{{ item.productName }}</strong>
                                        {% if item.sku %}
                                            <small class="text-muted">({{ item.sku }})</small>
                                        {% endif %}
                                        {% for flag in item.flags %}
                                            {% include molecule('status') with {
                                                data: {
                                                    label: (data.itemFlagLabelMap[flag] ?? flag) | trans,
                                                    status: data.itemFlagBadgeMap[flag],
                                                },
                                            } only %}
                                        {% endfor %}
                                    {% endblock %}

                                    {% block soldBy %}
                                        {% widget 'SoldByMerchantWidget' args [item] only %}{% endwidget %}
                                    {% endblock %}
                                    </div>
                                </div>
                            {% endblock %}

                            {% set itemPriceInfoClassName = "col spacing-x" %}
                            {% block itemPriceInfo %}
                                <div class="{{ itemPriceInfoClassName }}">
                                    <small>
                                        {{ currentQuantity }}x
                                        {% if priceChange %}
                                            <s>{{ referencePrice | money(true, data.currencyIsoCode) }}</s>
                                        {% endif %}
                                        {{ unitPrice | money(true, data.currencyIsoCode) }}
                                    </small>
                                    {% if priceChange %}
                                        {% set itemTolerance = item.priceTolerancePercent %}
                                        <br>
                                        <small class="text-muted" {{ qa('recurring-order-review-unflagged-price-change') }}>
                                            {% if priceChange.current < priceChange.previous %}
                                                ({{ 'recurring_orders.review.price_note.decreased' | trans }})
                                            {% elseif data.isProductCheckIgnored %}
                                                ({{ 'recurring_orders.review.price_note.within_order_tolerance' | trans({'%tolerance%': data.orderTolerance.trim() ~ '%'}) }})
                                            {% else %}
                                                ({{ 'recurring_orders.review.price_note.within_tolerance' | trans({'%tolerance%': itemTolerance.trim() ~ '%'}) }})
                                            {% endif %}
                                        </small>
                                    {% endif %}
                                </div>
                            {% endblock %}
                        </div>
                    {% endblock %}

                    {% block separator %}
                        {% if not loop.last %}
                            <hr class="separator" />
                        {% endif %}
                    {% endblock %}
                {% endfor %}
            </div>
        {% endblock %}
    </details>
{% endblock %}
