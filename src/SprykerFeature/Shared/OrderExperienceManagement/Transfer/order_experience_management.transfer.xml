    </transfer>

    <transfer name="RecurringScheduleConditions" strict="true">
        <property name="uuids" type="string[]" singular="uuid"/>
        <property name="customerIds" type="int[]" singular="customerId"/>
        <property name="companyIds" type="int[]" singular="companyId"/>
        <property name="companyBusinessUnitIds" type="int[]" singular="companyBusinessUnitId"/>
        <property name="statuses" type="string[]" singular="status"/>
        <property name="cadenceTypes" type="string[]" singular="cadenceType"/>
        <property name="idRecurringSchedules" type="int[]" singular="idRecurringSchedule"/>
        <property name="names" type="string[]" singular="name"/>
        <property name="nextTriggerDateFrom" type="string"/>
        <property name="nextTriggerDateTo" type="string"/>
