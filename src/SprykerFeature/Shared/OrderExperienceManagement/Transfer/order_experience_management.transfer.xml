        <property name="estimatedTotalMax" type="int"/>
        <property name="isWithHistory" type="bool"/>
        <property name="isWithItems" type="bool"/>
        <property name="isWithCustomer" type="bool"/>
        <property name="isWithCompany" type="bool"/>
        <property name="isWithLastExecution" type="bool"/>
        <property name="isWithQuoteData" type="bool"/>
        <property name="isWithSkipPreview" type="bool"/>
        <property name="isGroupedByGroupKey" type="bool"/>
