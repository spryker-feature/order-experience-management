        <property name="shipmentUnitGrossPrice" type="int"/>
        <property name="shipmentUnitNetPrice" type="int"/>
        <property name="itemData" type="string"/>
        <property name="itemTotal" type="int"/>
        <property name="flags" type="string[]" singular="flag"/>
    </transfer>

    <transfer name="RecurringScheduleCollection" strict="true">
        <property name="recurringSchedules" type="RecurringSchedule[]" singular="recurringSchedule"/>
        <property name="pagination" type="Pagination"/>
        <property name="statusCounts" type="RecurringScheduleStatusCount[]" singular="statusCount"/>
    </transfer>

    <transfer name="RecurringScheduleStatusCount" strict="true">
        <property name="status" type="string"/>
        <property name="count" type="int"/>
    </transfer>

    <transfer name="RecurringScheduleStatusCountCollection" strict="true">
        <property name="statusCounts" type="RecurringScheduleStatusCount[]" singular="statusCount"/>
    </transfer>

    <transfer name="RecurringScheduleForecast" strict="true">
        <property name="currencyIsoCode" type="string"/>
        <property name="cadenceType" type="string"/>
        <property name="cadenceValue" type="int"/>
        <property name="nextTriggerDate" type="string"/>
        <property name="estimatedTotal" type="int"/>
        <property name="plannedTotal" type="int"/>
        <property name="executedTotal" type="int"/>
