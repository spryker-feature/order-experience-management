    </transfer>

    <transfer name="RecurringScheduleError" strict="true">
        <property name="message" type="string"/>
        <property name="parameters" type="array" singular="parameter"/>
        <property name="isSuccess" type="bool"/>
        <property name="code" type="string"/>
    </transfer>

    <transfer name="RecurringScheduleHistory" strict="true">
        <property name="idRecurringScheduleHistory" type="int"/>
