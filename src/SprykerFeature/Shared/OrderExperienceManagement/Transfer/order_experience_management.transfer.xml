           xsi:schemaLocation="spryker:transfer-01 http://static.spryker.com/transfer-01.xsd">

    <transfer name="RecurringSchedule" strict="true">
        <property name="idRecurringSchedule" type="int"/>
        <property name="uuid" type="string"/>
        <property name="idCustomer" type="int"/>
        <property name="idCompanyUser" type="int"/>
        <property name="idSourceSalesOrder" type="int"/>
        <property name="idStateMachineItemState" type="int"/>
        <property name="name" type="string"/>
        <property name="cadenceType" type="string"/>
        <property name="cadenceValue" type="int"/>
        <property name="firstTriggerDate" type="string"/>
        <property name="nextTriggerDate" type="string"/>
        <property name="nextTriggerDateAfterSkip" type="string"/>
        <property name="notificationWindowHours" type="int"/>
        <property name="status" type="string"/>
        <property name="paymentMethod" type="string"/>
        <property name="storeName" type="string"/>
        <property name="currencyIsoCode" type="string"/>
        <property name="priceMode" type="string"/>
        <property name="customerReference" type="string"/>
        <property name="quoteData" type="string"/>
        <property name="quote" type="Quote"/>
        <property name="items" type="RecurringScheduleItem[]" singular="item"/>
