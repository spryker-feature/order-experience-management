        <property name="orderReference" type="string"/>
        <property name="failureReason" type="string"/>
        <property name="errors" type="RecurringScheduleError[]" singular="error"/>
    </transfer>

    <transfer name="RecurringOrderSettings" strict="true">
        <property name="cadenceType" type="string"/>
        <property name="cadenceValue" type="int"/>
        <property name="scheduleName" type="string"/>
        <property name="startDate" type="string"/>
        <property name="firstOrderDate" type="string"/>
    </transfer>

    <!-- Extend Quote transfer — single field instead of individual recurring properties -->
    <transfer name="Quote">
        <property name="recurringOrderSettings" type="RecurringOrderSettings"/>
        <property name="currency" type="Currency"/>
        <property name="priceMode" type="string"/>
        <property name="customerReference" type="string"/>
        <property name="expenses" type="Expense[]" singular="expense"/>
        <property name="payments" type="Payment[]" singular="payment"/>
        <property name="payment" type="Payment" deprecated="Use payments property instead."/>
        <property name="quoteRequestVersionReference" type="string"/>
        <property name="idQuote" type="int"/>
        <property name="billingAddress" type="Address"/>
        <property name="shippingAddress" type="Address" deprecated="Use item level shipping addresses (item.shipment.shippingAddress) instead."/>
        <property name="items" type="Item[]" singular="item"/>
        <property name="customer" type="Customer"/>
        <property name="store" type="Store"/>
        <property name="totals" type="Totals"/>
        <property name="idCostCenter" type="int"/>
        <property name="idBudget" type="int"/>
        <property name="orderReference" type="string"/>
        <property name="isLocked" type="bool"/>
        <property name="bundleItems" type="Item[]" singular="bundleItem"/>
        <property name="isAddressSavingSkipped" type="bool" deprecated="Use address transfer property (shippingAddress.isAddressSavingSkipped) instead."/>
        <property name="voucherCode" type="string"/>
        <property name="voucherDiscounts" type="Discount[]" singular="voucherDiscount"/>
        <property name="usedNotAppliedVoucherCodes" type="array" singular="usedNotAppliedVoucherCode"/>
    </transfer>

    <transfer name="RecurringOrderQuoteUpdateRequest" strict="true">
        <property name="idQuote" type="int"/>
        <property name="recurringOrderSettings" type="RecurringOrderSettings"/>
        <property name="customer" type="Customer"/>
    </transfer>

    <transfer name="RecurringOrderQuoteUpdateResponse" strict="true">
        <property name="isSuccessful" type="bool"/>
        <property name="errors" type="Error[]" singular="error"/>
        <property name="quote" type="Quote"/>
    </transfer>

    <!-- Result of reloading a placeable quote: the cart QuoteResponse plus the messenger error/info
         messages emitted DURING the reload (captured via a before/after snapshot diff). -->
    <transfer name="RecurringOrderReloadResult" strict="true">
        <property name="quoteResponse" type="QuoteResponse"/>
        <property name="newErrorMessages" type="string[]" singular="newErrorMessage"/>
        <property name="newInfoMessages" type="string[]" singular="newInfoMessage"/>
    </transfer>

    <transfer name="StateMachineItem">
        <property name="identifier" type="int"/>
        <property name="idItemState" type="int"/>
