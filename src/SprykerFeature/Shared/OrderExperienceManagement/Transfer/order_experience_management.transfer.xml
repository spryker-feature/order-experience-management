        <property name="quantity" type="int"/>
        <property name="nextDeliveryQuantity" type="int"/>
        <property name="referenceGrossPrice" type="int"/>
        <property name="referenceNetPrice" type="int"/>
        <property name="merchantReference" type="string"/>
        <property name="productOfferReference" type="string"/>
        <property name="groupKey" type="string"/>
        <property name="bundleItemIdentifier" type="string"/>
        <property name="relatedBundleItemIdentifier" type="string"/>
        <property name="bundledItems" type="RecurringScheduleItem[]" singular="bundledItem"/>
